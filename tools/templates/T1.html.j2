{#- T1 — single column, classic.
    Identity (name, pronouns, e-mail) appears ONLY in <header>. See docs/01 §11.6. -#}
<!doctype html>
<html><head><meta charset="utf-8"><style>
  @page { size: A4; margin: 18mm 20mm; }
  body { font-family: Georgia, "Times New Roman", serif; font-size: 10.5pt; color: #1d1d1d; margin: 0; line-height: 1.35; }
  header { text-align: center; margin-bottom: 14px; }
  header h1 { margin: 0; font-size: 21pt; font-weight: normal; letter-spacing: .5px; }
  header .pronouns { font-size: 10pt; color: #555; }
  header .contact { margin-top: 4px; font-size: 9.5pt; color: #333; }
  h2 { font-size: 11pt; text-transform: uppercase; letter-spacing: 1.5px; border-bottom: 1px solid #999;
       padding-bottom: 2px; margin: 14px 0 6px; }
  .role { display: flex; justify-content: space-between; font-weight: bold; }
  .employer { font-style: italic; margin-bottom: 2px; }
  ul { margin: 2px 0 8px; padding-left: 18px; }
  p { margin: 0 0 6px; }
</style></head><body>
<header>
  <h1>{{ name }}{% if pronouns %} <span class="pronouns">({{ pronouns }})</span>{% endif %}</h1>
  <div class="contact">{{ email }}{% if p.phone %} · {{ p.phone }}{% endif %} · {{ p.location }}</div>
</header>

<h2>Summary</h2>
<p>{{ p.summary }}</p>
{% for goal in p.learning %}<p>{{ goal.text }}</p>{% endfor %}

<h2>Skills</h2>
<p>{{ p.skills | map(attribute='text') | join(', ') }}</p>

{% if p.experience %}
<h2>Experience</h2>
{% for job in p.experience %}
<div class="role"><span>{{ job.title }}</span><span>{{ job.start | month }} – {{ job.end | month }}</span></div>
<div class="employer">{{ job.employer }}</div>
<ul>{% for b in job.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
{% endfor %}
{% endif %}

{% if p.projects %}
<h2>Projects</h2>
{% for pr in p.projects %}<p><b>{{ pr.name }}</b> — {{ pr.text }}</p>{% endfor %}
{% endif %}

<h2>Education</h2>
{% for e in p.education %}
<p><b>{{ e.degree_text }}</b>, {{ e.institution }}, {{ e.end_year }}</p>
{% endfor %}
</body></html>
