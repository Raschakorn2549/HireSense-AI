{#- T4 — TWO columns, sidebar on the RIGHT (mirror of T2), icons, skill tags.
    Reserved for the evaluation set (Tier B) — docs/02 §5.1.
    Identity (name, pronouns, e-mail) appears ONLY in <header>. See docs/01 §11.6. -#}
{% import "_parts.html.j2" as parts %}
<!doctype html>
<html><head><meta charset="utf-8"><style>
  @page { size: A4; margin: 15mm; }
  body { font-family: "Trebuchet MS", Verdana, sans-serif; font-size: 10pt; color: #202020;
         margin: 0; line-height: 1.4; background: #ffffff; }
  header { display: flex; justify-content: space-between; align-items: flex-end;
           border-bottom: 3px solid #0f766e; padding-bottom: 8px; margin-bottom: 12px; }
  header h1 { margin: 0; font-size: 20pt; color: #0f766e; }
  header .pronouns { font-size: 10pt; color: #555; font-weight: normal; }
  header .contact { text-align: right; font-size: 9.5pt; line-height: 1.5; }
  .grid { display: grid; grid-template-columns: 1fr 30%; gap: 20px; }
  aside { border-left: 1px solid #cfd8d6; padding-left: 14px; }
  h2 { font-size: 10.5pt; color: #0f766e; text-transform: uppercase; letter-spacing: 1px; margin: 10px 0 5px; }
  .tag { display: inline-block; border: 1px solid #0f766e; border-radius: 9px; padding: 1px 7px;
         margin: 0 3px 4px 0; font-size: 9pt; }
  .role { font-weight: bold; }
  .meta { color: #555; font-size: 9.5pt; margin-bottom: 2px; }
  main ul { margin: 2px 0 8px; padding-left: 16px; }
  p { margin: 0 0 6px; }
  {{ parts.hidden_css() }}
</style></head><body>
<header>
  <h1>{{ name }}{% if pronouns %} <span class="pronouns">({{ pronouns }})</span>{% endif %}</h1>
  <div class="contact">&#9993; {{ email }}{% if p.phone %}<br>&#9742; {{ p.phone }}{% endif %}</div>
</header>
<div class="grid">
  <main>
    <h2>About</h2>
    <p>{{ p.summary }}</p>
    {% for goal in p.learning %}<p>{{ goal.text }}</p>{% endfor %}
    {{ parts.hidden(p.hidden_text) }}
    {% if p.experience %}
    <h2>Experience</h2>
    {% for job in p.experience %}
    <div class="role">{{ job.title }}</div>
    <div class="meta">{{ job.employer }} &middot; {{ job.start | month }} – {{ job.end | month }}</div>
    <ul>{% for b in job.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
    {% endfor %}
    {% endif %}
    {% if p.projects %}
    <h2>Projects</h2>
    {% for pr in p.projects %}<p><b>{{ pr.name }}</b> — {{ pr.text }}</p>{% endfor %}
    {% endif %}
  </main>
  <aside>
    <h2>Skills</h2>
    <div>{% for s in p.skills %}<span class="tag">{{ s.text }}</span>{% endfor %}</div>
    <h2>Education</h2>
    {% for e in p.education %}<p><b>{{ e.degree_text }}</b><br>{{ e.institution }}<br>{{ e.end_year }}</p>{% endfor %}
    <h2>Based in</h2>
    <p>{{ p.location }}</p>
  </aside>
</div>
</body></html>
